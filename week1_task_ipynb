Basic Python Commands with Proper Code Examples:

1. Print Output
Used to display output on screen.
print("Hello, World!")
print(10 + 5)

2. Variables and Data Types
Store values in variables.
name = "Jahnavi"
age = 21
height = 5.3
is_student = True
print(name, age, height, is_student)

3. Taking User Input
name = input("Enter your name: ")
age = int(input("Enter your age: "))
print("Hello", name)
print("You are", age, "years old")

4. Type Casting
Convert one data type to another.
x = "10"
y = int(x)
print(y + 5)  # Output: 15

5. Arithmetic Operations
a = 10
b = 3
print(a + b)   # Addition
print(a - b)   # Subtraction
print(a * b)   # Multiplication
print(a / b)   # Division
print(a % b)   # Modulus
print(a ** b)  # Power
print(a // b)  # Floor division

6. Conditional Statements (if-else)
age = 18
if age >= 18:
    print("Eligible to vote")
else:
    print("Not eligible")

7. Loops
#For Loop
for i in range(5):
    print(i)
#While Loop
i = 1
while i <= 5:
    print(i)
    i += 1

8. Lists
fruits = ["apple", "banana", "cherry"]
print(fruits[0])
fruits.append("orange")
print(fruits)

9. Tuples
numbers = (1, 2, 3, 4)
print(numbers[1])

10. Dictionaries
student = {
    "name": "Jahnavi",
    "age": 21,
    "course": "CSE"
}
print(student["name"])

11. Functions
def greet(name):
    return "Hello " + name
print(greet("Jahnavi"))

12. Importing Modules
import math
print(math.sqrt(16))

13. File Handling
# Writing to file
file = open("test.txt", "w")
file.write("Hello Python")
file.close()
# Reading file
file = open("test.txt", "r")
print(file.read())
file.close()

14. Exception Handling
try:
    x = int(input("Enter number: "))
    print(10 / x)
except:
    print("Error occurred")

15. Comments
# This is a single-line comment
"""
This is amulti-line comment
"""

16. Check Even or Odd
num = int(input("Enter number: "))
if num % 2 == 0:
    print("Even")
else:
    print("Odd")

17. Find Largest of Three Numbers
a, b, c = 10, 25, 15
if a > b and a > c:
    print("Largest:", a)
elif b > c:
    print("Largest:", b)
else:
    print("Largest:", c)

18. Sum of First N Numbers
n = int(input("Enter n: "))
sum = 0
for i in range(1, n + 1):
    sum += i
print("Sum:", sum)

19. Factorial of a Number
n = int(input("Enter number: "))
fact = 1
for i in range(1, n + 1):
    fact *= i
print("Factorial:", fact)

20. Reverse a String
text = input("Enter string: ")
print(text[::-1])

21. Check Palindrome
text = input("Enter string: ")
if text == text[::-1]:
    print("Palindrome")
else:
    print("Not Palindrome")

22. Count Vowels in String
text = input("Enter string: ")
count = 0
for char in text:
    if char.lower() in "aeiou":
        count += 1
print("Vowels:", count)

23. Fibonacci Series
n = int(input("Enter terms: "))
a, b = 0, 1
for i in range(n):
    print(a, end=" ")
    a, b = b, a + b

24. Multiplication Table
num = int(input("Enter number: "))
for i in range(1, 11):
    print(num, "x", i, "=", num * i)

25. Find Prime Number
num = int(input("Enter number: "))
is_prime = True
if num <= 1:
    is_prime = False
else:
    for i in range(2, num):
        if num % i == 0:
            is_prime = False
            break
print("Prime" if is_prime else "Not Prime")

26. Remove Duplicates from List
nums = [1, 2, 2, 3, 4, 4]
unique = list(set(nums))
print(unique)

27. Find Maximum in List
nums = [10, 45, 23, 89, 12]
print("Max:", max(nums))

28. Sort List
nums = [5, 2, 9, 1]
nums.sort()
print(nums)

29. Count Words in Sentence
sentence = input("Enter sentence: ")
words = sentence.split()
print("Word count:", len(words))

30. Simple Calculator
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
op = input("Enter operator (+, -, *, /): ")
if op == "+":
    print(a + b)
elif op == "-":
    print(a - b)
elif op == "*":
    print(a * b)
elif op == "/":
    print(a / b)
else:
    print("Invalid operator")

Basic SQL Commands with Proper Code Examples:

1. CREATE DATABASE
Creates a new database.
CREATE DATABASE student_db;

2. USE DATABASE
Select the database to work with.
USE student_db;

3. CREATE TABLE
Creates a table with columns.
CREATE TABLE students (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    age INT,
    course VARCHAR(50)
);

4. INSERT INTO
Insert data into table.
INSERT INTO students (id, name, age, course)
VALUES (1, 'Jahnavi', 21, 'CSE');
INSERT INTO students VALUES (2, 'Ravi', 22, 'ECE');

5. SELECT
Retrieve data from table.
SELECT * FROM students;
SELECT name, age FROM students;

6. WHERE (Filter Data)
SELECT * FROM students
WHERE age > 21;

7. UPDATE
Modify existing data.
UPDATE students
SET age = 23
WHERE id = 2;

8. DELETE
Delete records.
DELETE FROM students
WHERE id = 1;

9. TRUNCATE
Delete all rows (fast).
TRUNCATE TABLE students;

10. DROP
Delete table completely.
DROP TABLE students;

11. ORDER BY
Sort results.
SELECT * FROM students
ORDER BY age DESC;

12. LIMIT
Limit number of results.
SELECT * FROM students
LIMIT 2;

13. AND / OR
Multiple conditions.
SELECT * FROM students
WHERE age > 20 AND course = 'CSE';
SELECT * FROM students
WHERE age < 22 OR course = 'ECE';

14. LIKE (Pattern Matching)
SELECT * FROM students
WHERE name LIKE 'J%';   -- starts with J

15. COUNT, AVG, SUM
Aggregate functions.
SELECT COUNT(*) FROM students;
SELECT AVG(age) FROM students;
SELECT SUM(age) FROM students;

16. JOIN (Basic)
Combine two tables.
SELECT s.name, c.course_name
FROM students s
JOIN courses c
ON s.course = c.course_id;

17. ALTER TABLE
Modify table structure.
ALTER TABLE students
ADD email VARCHAR(100);

18. PRIMARY KEY
Ensures unique values.
CREATE TABLE test (
    id INT PRIMARY KEY,
    name VARCHAR(50)
);

19. NOT NULL
Column must have value.
CREATE TABLE emp (
    id INT,
    name VARCHAR(50) NOT NULL
);

20. DISTINCT
Remove duplicate values.
SELECT DISTINCT course FROM students;

21. SELECT with BETWEEN
SELECT * FROM students
WHERE age BETWEEN 18 AND 22;

22. IN Operator
SELECT * FROM students
WHERE course IN ('CSE', 'ECE');

23. NOT IN
SELECT * FROM students
WHERE course NOT IN ('CSE');

24. IS NULL
SELECT * FROM students
WHERE email IS NULL;

25. IS NOT NULL
SELECT * FROM students
WHERE email IS NOT NULL;

26. COUNT with Condition
SELECT COUNT(*) 
FROM students
WHERE age > 20;

27. GROUP BY
SELECT course, COUNT(*) 
FROM students
GROUP BY course;

28. HAVING Clause
SELECT course, COUNT(*) 
FROM students
GROUP BY course
HAVING COUNT(*) > 1;

29. MAX and MIN
SELECT MAX(age) FROM students;
SELECT MIN(age) FROM students;

30. UPPER and LOWER
SELECT UPPER(name) FROM students;
SELECT LOWER(name) FROM students;

31. LENGTH Function
SELECT name, LENGTH(name) 
FROM students;

32. CONCAT Strings
SELECT CONCAT(name, ' - ', course) AS details
FROM students;

33. Alias (AS)
SELECT name AS student_name
FROM students;

34. INNER JOIN
SELECT s.name, c.course_name
FROM students s
INNER JOIN courses c
ON s.course = c.id;

35. LEFT JOIN
SELECT s.name, c.course_name
FROM students s
LEFT JOIN courses c
ON s.course = c.id;

36. RIGHT JOIN
SELECT s.name, c.course_name
FROM students s
RIGHT JOIN courses c
ON s.course = c.id;

37. Subquery
SELECT name 
FROM students
WHERE age = (SELECT MAX(age) FROM students);

38. EXISTS
SELECT name
FROM students s
WHERE EXISTS (
    SELECT 1 FROM courses c
    WHERE s.course = c.id
);

39. CASE Statement
SELECT name,
CASE 
    WHEN age >= 18 THEN 'Adult'
    ELSE 'Minor'
END AS status
FROM students;

40. AUTO INCREMENT
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50)
);


